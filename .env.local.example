# === Auth.js (Phase 2) ===
# MANUAL: Generate with `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET=MANUAL_REPLACE_WITH_RANDOM_SECRET

# MANUAL: From GitHub OAuth App -> Client ID
# HOW TO GET IT:
# 1) Open https://github.com/settings/developers
# 2) Click OAuth Apps -> New OAuth App
# 3) Set Application name to any value (example: DevCard Local)
# 4) Set Homepage URL to http://localhost:3000
# 5) Set Authorization callback URL to http://localhost:3000/api/auth/callback/github
# 6) Click Register application
# 7) Copy Client ID into AUTH_GITHUB_ID
AUTH_GITHUB_ID=MANUAL_REPLACE_WITH_GITHUB_CLIENT_ID

# MANUAL: From the same OAuth App -> Generate a new client secret
# HOW TO GET IT:
# 1) Open the OAuth App created above
# 2) Click Generate a new client secret
# 3) Confirm your GitHub password if prompted
# 4) Copy the secret immediately into AUTH_GITHUB_SECRET
AUTH_GITHUB_SECRET=MANUAL_REPLACE_WITH_GITHUB_CLIENT_SECRET

# MANUAL: Local dev URL (use your deployed URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MANUAL (GitHub OAuth App settings):
# Authorization callback URL must be:
# http://localhost:3000/api/auth/callback/github
# PHASE 3 NOTE:
# You do NOT manually create a GitHub access token.
# The access token used by /api/github/sync is issued automatically after OAuth sign-in.
# DEV_GITHUB_TOKEN below is only for optional local bypass mode.

# === Optional local-only sync bypass (development only) ===
# WARNING: Keep these local. Never set in production.
# Enable by sending matching x-dev-sync-secret header to /api/github/sync.
# Set to true only when you explicitly need bypass mode in local development.
ENABLE_DEV_SYNC_BYPASS=false
DEV_SYNC_BYPASS_SECRET=
# Optional fallback token/login for bypass mode when request headers are not provided.
# HOW TO GET DEV_GITHUB_TOKEN (optional):
# 1) Open https://github.com/settings/tokens
# 2) Create a temporary token with only read-level access needed for profile/repo metadata
# 3) Use a short expiration and copy the token value once into DEV_GITHUB_TOKEN
# 4) Keep this token local-only and never reuse it in production or CI
# HOW TO GET DEV_GITHUB_LOGIN:
# 1) Open your GitHub profile page
# 2) Copy your handle from the URL https://github.com/<handle>
DEV_GITHUB_TOKEN=
DEV_GITHUB_LOGIN=

# === AWS (Phase 5 placeholders) ===
# MANUAL: Pick your AWS region (project default: eu-central-1)
AWS_REGION=eu-central-1
# MANUAL: From AWS Console -> IAM -> Users -> Create user
# HOW TO GET IT:
# 1) Create an IAM user for DevCard with programmatic access
# 2) Attach least-privilege policies for DynamoDB + S3 + CloudFront read (as needed)
# 3) Open the created access key entry and copy Access key ID
AWS_ACCESS_KEY_ID=MANUAL_REPLACE_WITH_IAM_ACCESS_KEY_ID
# MANUAL: From the same IAM access key entry
# HOW TO GET IT:
# 1) Copy Secret access key at creation time (it is shown once)
# 2) Store it in AWS_SECRET_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=MANUAL_REPLACE_WITH_IAM_SECRET_ACCESS_KEY
# MANUAL: Create DynamoDB table and use the exact table name
DYNAMODB_TABLE_USERS=devcard-users
# MANUAL: Create DynamoDB table and use the exact table name
DYNAMODB_TABLE_CARDS=devcard-cards
# MANUAL: From AWS Console -> S3 -> Create bucket
S3_BUCKET_NAME=devcard-images
# MANUAL: From AWS Console -> CloudFront -> Distributions -> Domain name
# Example format: d1234abcd.cloudfront.net
CLOUDFRONT_DOMAIN=MANUAL_REPLACE_WITH_CLOUDFRONT_DOMAIN