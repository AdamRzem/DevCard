{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DevCardUsersReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:MANUAL_REPLACE_REGION:MANUAL_REPLACE_ACCOUNT_ID:table/devcard-users"
    },
    {
      "Sid": "DevCardCardsRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:MANUAL_REPLACE_REGION:MANUAL_REPLACE_ACCOUNT_ID:table/devcard-cards"
    },
    {
      "Sid": "DevCardCardsSlugIndexQuery",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:MANUAL_REPLACE_REGION:MANUAL_REPLACE_ACCOUNT_ID:table/devcard-cards/index/slug-index"
    },
    {
      "Sid": "DevCardCardsTransactionalWrites",
      "Effect": "Allow",
      "Action": [
        "dynamodb:TransactWriteItems"
      ],
      "Resource": "arn:aws:dynamodb:MANUAL_REPLACE_REGION:MANUAL_REPLACE_ACCOUNT_ID:table/devcard-cards"
    }
  ]
}
